    "Entries marked as compromised cap their own score and lower the vault score." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als kompromittiert markierte Einträge begrenzen ihren eigenen Score und senken den Tresor-Score."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
