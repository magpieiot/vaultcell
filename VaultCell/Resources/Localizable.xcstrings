        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Prüfung auf Datenlecks ist noch nicht verfügbar, daher senken kompromittierte Einträge deine Bewertung nicht. Aktiviere diese Option, um sie unter Sicherheitsbewertung aufzulisten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La detección de filtraciones aún no está disponible, por lo que las entradas comprometidas no reducen tu puntuación. Actívalo para listarlas en Seguridad."
