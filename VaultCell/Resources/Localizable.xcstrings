    "Only the first and last two characters are shown. Open a group to see the full password — it never touches the clipboard." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur das erste und die letzten beiden Zeichen werden angezeigt. Öffnen Sie eine Gruppe, um das vollständige Passwort zu sehen — es landet nie in der Zwischenablage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the first and last two characters are shown. Open a group to see the full password — it never touches the clipboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se muestran el primer carácter y los dos últimos. Abre un grupo para ver la contraseña completa: nunca pasa por el portapapeles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls le premier et les deux derniers caractères sont affichés. Ouvrez un groupe pour voir le mot de passe complet : il ne passe jamais par le presse-papiers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先頭と末尾 2 文字のみ表示しています。グループを開くと完全なパスワードを確認できます。クリップボードには渡りません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показаны только первый и два последних символа. Откройте группу, чтобы увидеть пароль целиком — он не попадает в буфер обмена."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅显示首字符和末两位字符。展开分组可查看完整密码，全程不经过剪贴板。"
          }
        }
      }
    },
