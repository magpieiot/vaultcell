    "Accounts without 2FA are easier to take over even when the password is strong." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konten ohne 2FA lassen sich leichter übernehmen, selbst bei starkem Passwort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cuentas sin 2FA son más fáciles de comprometer aunque la contraseña sea fuerte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les comptes sans 2FA sont plus faciles à prendre le contrôle même avec un mot de passe fort."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
