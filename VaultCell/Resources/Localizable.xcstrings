    "Bug reports and feature requests are welcome by email, and an App Store review helps other people find VaultCell." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehlerberichte und Feature-Wünsche sind per E-Mail jederzeit willkommen; eine Bewertung im App Store hilft anderen, VaultCell zu finden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bug reports and feature requests are welcome by email, and an App Store review helps other people find VaultCell."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los informes de errores y las sugerencias son bienvenidos por correo; una reseña en el App Store ayuda a otros a descubrir VaultCell."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rapports de bugs et les suggestions sont les bienvenus par e-mail ; un avis sur l'App Store aide d'autres personnes à découvrir VaultCell."
