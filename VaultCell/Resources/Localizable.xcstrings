    "This device has a different vault from the one in iCloud. Back up the local vault, reset it, then restore the original vault from iCloud." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Tresor auf diesem Gerät unterscheidet sich von dem in iCloud. Sichere den lokalen Tresor, setze ihn zurück und stelle dann den ursprünglichen Tresor aus iCloud wieder her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device has a different vault from the one in iCloud. Back up the local vault, reset it, then restore the original vault from iCloud."
          }
