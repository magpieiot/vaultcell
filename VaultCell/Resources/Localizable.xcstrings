    "Exported files are not encrypted. Keep them somewhere safe and delete them when you are done." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportierte Dateien sind nicht verschlüsselt. Bewahren Sie sie sicher auf und löschen Sie sie, wenn Sie fertig sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exported files are not encrypted. Keep them somewhere safe and delete them when you are done."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos exportados no están cifrados. Guárdalos en un lugar seguro y elimínalos cuando hayas terminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers exportés ne sont pas chiffrés. Conservez-les dans un endroit sûr et supprimez-les une fois terminé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エクスポートしたファイルは暗号化されていません。安全な場所に保管し、作業が終わったら削除してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспортированные файлы не зашифрованы. Храните их в надёжном месте и удалите после завершения работы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
