    "Nothing blocks you. No saved account depends on this to get back in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts steht dem entgegen. Kein gespeichertes Konto braucht dies, um wieder Zugang zu erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing blocks you. No saved account depends on this to get back in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada te lo impide. Ninguna cuenta guardada depende de esto para recuperar el acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien ne vous bloque. Aucun compte enregistré n’en dépend pour être récupéré."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "妨げるものはありません。この連絡先に依存して復元するアカウントはありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничто не мешает: ни один сохранённый аккаунт не зависит от него для восстановления доступа."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有阻碍项：没有已保存的账户需要靠它找回。"
          }
        }
      }
    },
    "Nothing here needs action. Turn off the filter to see every saved identity." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier ist nichts zu tun. Deaktivieren Sie den Filter, um alle gespeicherten Identitäten zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing here needs action. Turn off the filter to see every saved identity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí no hay nada que requiera acción. Desactiva el filtro para ver todas las identidades guardadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à faire ici. Désactivez le filtre pour voir toutes les identités enregistrées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対応が必要なものはありません。フィルタをオフにすると保存済みのすべての連絡先が表示されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
