    "Keep your passwords, bank cards, secure notes and verification codes in one safe place." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewahren Sie Ihre Passwörter, Bankkarten, Notizen und Verifizierungscodes an einem sicheren Ort auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tus contraseñas, tarjetas bancarias, notas seguras y códigos de verificación en un solo lugar seguro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservez vos mots de passe, cartes bancaires, notes sécurisées et codes de vérification en un seul endroit sûr."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワード、銀行カード、セキュアノート、認証コードを1か所で安全に管理。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храните пароли, банковские карты, защищённые заметки и коды подтверждения в одном надёжном месте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将你的密码、银行卡、安全笔记与验证码集中保管在一个安全之处。"
          }
        }
      }
    },
