    "Entries marked as compromised cap their own score and lower the vault score." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als kompromittiert markierte Einträge deckeln ihren eigenen Score und senken den Tresor-Score."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las entradas marcadas como comprometidas limitan su propia puntuación y bajan la puntuación de la bóveda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les entrées marquées comme compromises plafonnent leur score et abaissent le score du coffre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "流出とマークされた項目は自身のスコアに上限を設け、ボールトのスコアを下げます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи, отмеченные как скомпрометированные, ограничивают свой балл и снижают балл хранилища."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被标记为已泄露的条目会拉低自身评分并降低密码库总分。"
          }
        }
      }
    },
