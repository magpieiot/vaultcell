    "Nothing blocks you. No saved account depends on this to get back in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts steht dem entgegen. Kein gespeichertes Konto braucht dies, um wieder Zugang zu erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada te lo impide. Ninguna cuenta guardada depende de esto para recuperar el acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien ne vous bloque. Aucun compte enregistré n’en dépend pour être récupéré."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "妨げるものはありません。この連絡先に依存して復元するアカウントはありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничто не мешает: ни один сохранённый аккаунт не зависит от него для восстановления доступа."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有阻碍项：没有已保存的账户需要靠它找回。"
          }
        }
      }
    },
    "Nothing here needs action. Turn off the filter to see every saved identity." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
