    "Securely manage your third-party service credentials via OAuth 2.0 — no manual password entry needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwalten Sie die Anmeldedaten Ihrer Drittanbieterdienste sicher über OAuth 2.0 — keine manuelle Passworteingabe erforderlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestiona de forma segura las credenciales de tus servicios de terceros mediante OAuth 2.0 — sin necesidad de introducir contraseñas manualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gérez en toute sécurité les identifiants de vos services tiers via OAuth 2.0 — aucune saisie manuelle de mot de passe requise."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OAuth 2.0 を使用してサードパーティサービスの認証情報を安全に管理 — パスワードの手動入力は不要です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безопасно управляйте учётными данными сторонних сервисов через OAuth 2.0 — ручной ввод пароля не требуется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
