    "%lld accounts use it for verification. Rebind those before you give it up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Konten nutzen es zur Verifizierung. Verknüpfen Sie diese vorher neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld cuentas lo usan para la verificación. Vuelve a vincularlas antes de renunciar a él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld comptes l’utilisent pour la vérification. Reliez-les d’abord à une autre identité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 件のアカウントが認証に使用しています。手放す前に再連携してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
