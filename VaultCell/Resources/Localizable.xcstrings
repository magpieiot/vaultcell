    "Your vault has several high-risk patterns. Address the top items as soon as possible." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Tresor weist mehrere risikoreiche Muster auf. Beheben Sie die wichtigsten Punkte so bald wie möglich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu bóveda tiene varios patrones de alto riesgo. Atiende los puntos principales lo antes posible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre coffre présente plusieurs schémas à haut risque. Traitez les points principaux dès que possible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保管庫には高リスクのパターンがいくつかあります。優先項目にできるだけ早く対応してください。"
          }
        },
        "ru" : {
