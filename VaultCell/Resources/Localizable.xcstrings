    "AES-256-GCM authenticated encryption with Secure Enclave isolation. Your master key never touches disk." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256-GCM authentifizierte Verschlüsselung mit Secure-Enclave-Isolation. Ihr Hauptschlüssel verlässt niemals den Speicher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cifrado autenticado AES-256-GCM con aislamiento de Secure Enclave. Tu clave maestra nunca toca el disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiffrement authentifié AES-256-GCM avec isolation Secure Enclave. Votre clé maîtresse n'est jamais écrite sur le disque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secure Enclave 分離による AES-256-GCM 認証付き暗号化。マスターキーがディスクに保存されることはありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аутентифицированное шифрование AES-256-GCM с изоляцией Secure Enclave. Ваш главный ключ никогда не попадает на диск."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "采用 Secure Enclave 隔离的 AES-256-GCM 认证加密，主密钥永不落盘。"
          }
        }
      }
    },
