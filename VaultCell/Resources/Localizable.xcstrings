    "Your vault is encrypted and stored on this device or in your private iCloud account. We never collect, sell, or share your data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Tresor ist verschlüsselt und wird auf diesem Gerät oder in deinem privaten iCloud-Konto gespeichert. Wir erfassen, verkaufen oder teilen deine Daten niemals."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your vault is encrypted and stored on this device or in your private iCloud account. We never collect, sell, or share your data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu bóveda está cifrada y se guarda en este dispositivo o en tu cuenta privada de iCloud. Nunca recopilamos, vendemos ni compartimos tus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre coffre est chiffré et conservé sur cet appareil ou dans votre compte iCloud privé. Nous ne collectons, ne vendons ni ne partageons jamais vos données."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保管庫は暗号化され、このデバイスまたはプライベートな iCloud アカウントに保存されます。データを収集・販売・共有することはありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше хранилище зашифровано и хранится на этом устройстве или в вашей личной учётной записи iCloud. Мы никогда не собираем, не продаём и не передаём ваши данные."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的密码库经过加密，存储在设备或你的私人 iCloud 帐户中。我们不会收集、出售或共享这些数据。"
          }
        }
      }
    },
