    "Change these accounts one at a time. Breach detection is not available yet, so reuse is the clearest signal you have." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändern Sie diese Konten nacheinander. Die Leck-Erkennung ist noch nicht verfügbar, daher ist Wiederverwendung das deutlichste Signal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change these accounts one at a time. Breach detection is not available yet, so reuse is the clearest signal you have."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia estas cuentas una por una. La detección de filtraciones aún no está disponible, así que la reutilización es la señal más clara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changez ces comptes un par un. La détection de fuites n'est pas encore disponible : la réutilisation est donc le signal le plus fiable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのアカウントは 1 つずつ変更してください。漏えい検出はまだ利用できないため、使い回しが最も明確な判断材料です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняйте эти аккаунты по одному. Обнаружение утечек пока недоступно, поэтому повторное использование — самый явный сигнал."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请逐个修改这些账户。泄露检测尚未上线，因此重复使用是最明确的判断依据。"
          }
        }
      }
    },
