    "Reusing a password lets one breach unlock every account that shares it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei wiederverwendeten Passwörtern öffnet ein einziges Leck alle Konten, die es teilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reusing a password lets one breach unlock every account that shares it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reutilizar una contraseña hace que una filtración abra todas las cuentas que la comparten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réutiliser un mot de passe permet à une seule fuite d'ouvrir tous les comptes qui le partagent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードを使い回すと、1 件の漏えいで共有しているすべてのアカウントが開かれます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При повторном использовании одна утечка открывает все аккаунты с этим паролем."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重复使用密码会让一次泄露打开所有共用它的账号。"
          }
        }
      }
    },
    "Reusing passwords increases the blast radius of a single leak." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wiederverwendung von Passwörtern vergrößert den Schaden eines einzelnen Lecks."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reusing passwords increases the blast radius of a single leak."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reutilizar contraseñas aumenta el radio de impacto de una sola filtración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réutiliser des mots de passe augmente le rayon d'impact d'une seule fuite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードの使い回しは、1回の漏えいによる被害範囲を広げます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторное использование паролей увеличивает радиус поражения от одной утечки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重复使用密码会放大单次泄露的影响范围。"
          }
        }
