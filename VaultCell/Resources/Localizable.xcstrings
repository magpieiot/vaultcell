    "Your master password encrypts the entire vault and cannot be recovered. Please keep it safe." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Master-Passwort verschlüsselt den gesamten Tresor und kann nicht wiederhergestellt werden. Bitte bewahren Sie es sicher auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
