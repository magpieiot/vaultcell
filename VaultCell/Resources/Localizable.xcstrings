    "Long press and drag to reorder. System default categories cannot be deleted. Deleting a custom category will reassign its entries to \"%@\"." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Sortieren gedrückt halten und ziehen. Systemstandardkategorien können nicht gelöscht werden. Beim Löschen einer benutzerdefinierten Kategorie werden ihre Einträge „%@“ zugeordnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long press and drag to reorder. System default categories cannot be deleted. Deleting a custom category will reassign its entries to \"%@\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado y arrastra para reordenar. Las categorías predeterminadas del sistema no se pueden eliminar. Al eliminar una categoría personalizada, sus entradas se reasignarán a «%@»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez longuement et faites glisser pour réorganiser. Les catégories système ne peuvent pas être supprimées. La suppression d'une catégorie personnalisée réaffectera ses entrées à « %@ »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長押ししてドラッグすると並べ替えできます。システムのデフォルトカテゴリは削除できません。カスタムカテゴリを削除すると、その項目は「%@」に移動されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Долгое нажатие и перетаскивание для изменения порядка. Системные категории по умолчанию нельзя удалить. При удалении пользовательской категории её записи будут перемещены в «%@»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按拖动可调整顺序。系统默认类别无法删除。删除自定义类别后，其条目将重新归入“%@”。"
          }
        }
      }
    },
    "Longer passwords take far more effort to crack. Aim for 16 or more." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Längere Passwörter sind deutlich schwerer zu knacken. Zielen Sie auf 16 Zeichen oder mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longer passwords take far more effort to crack. Aim for 16 or more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las contraseñas largas cuestan mucho más de descifrar. Apunta a 16 caracteres o más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mots de passe longs sont bien plus difficiles à casser. Visez 16 caractères ou plus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長いパスワードほど解読に時間がかかります。16 文字以上を目安にしてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Длинные пароли подбирать гораздо сложнее. Стремитесь к 16 символам и больше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码越长越难破解，建议 16 位以上。"
          }
        }
      }
    },
