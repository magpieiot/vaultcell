    "Use Export Data in Settings to create one encrypted backup file, move it to the new device, and use Import to restore everything — including tags and two-factor secrets." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle über Daten exportieren in den Einstellungen eine verschlüsselte Backup-Datei, übertrage sie auf das neue Gerät und stelle über Importieren alles wieder her – inklusive Tags und 2FA-Geheimnissen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Export Data in Settings to create one encrypted backup file, move it to the new device, and use Import to restore everything — including tags and two-factor secrets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Exportar datos en Ajustes para crear un archivo de copia cifrada, llévalo al nuevo dispositivo y usa Importar para restaurarlo todo, incluidas las etiquetas y los secretos 2FA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Exporter les données dans les Réglages pour créer un fichier de sauvegarde chiffré, transférez-le sur le nouvel appareil, puis utilisez Importer pour tout restaurer, y compris les étiquettes et les secrets 2FA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定のデータを書き出しで暗号化バックアップを 1 つ作成し、新しい端末に移してから読み込みで復元してください。タグや二段階認証のシークレットも含まれます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте зашифрованную резервную копию через «Экспорт данных» в Настройках, перенесите её на новое устройство и восстановите всё через «Импорт» — включая метки и секреты 2FA."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在设置的导出数据中创建一份加密备份文件，传到新设备后用导入功能恢复全部内容，其中也包括标签与两步验证密钥。"
          }
        }
      }
    },
    "Use at least 8 characters and mix upper/lower case letters, digits and symbols." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie mindestens 8 Zeichen und mischen Sie Groß- und Kleinbuchstaben, Ziffern und Sonderzeichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use at least 8 characters and mix upper/lower case letters, digits and symbols."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa al menos 8 caracteres y combina mayúsculas, minúsculas, dígitos y símbolos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez au moins 8 caractères en mélangeant majuscules, minuscules, chiffres et symboles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8文字以上で、大文字・小文字・数字・記号を組み合わせてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте не менее 8 символов и сочетайте заглавные и строчные буквы, цифры и символы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少 8 个字符，并混合大小写字母、数字和符号。"
          }
        }
      }
    },
    "Use the create flow to add your first vault item." : {
