    "%lld accounts keep it on file, but all of them have another way to recover." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Konten haben es hinterlegt, aber alle haben einen anderen Weg zur Wiederherstellung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld cuentas lo tienen registrado, pero todas tienen otra forma de recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld comptes l’ont enregistré, mais tous disposent d’un autre moyen de récupération."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 件のアカウントが保存していますが、いずれも別の復元手段があります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld аккаунтов хранят его, но у всех есть другой способ восстановления."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %lld 个账户留存了它，但它们都有其他找回方式。"
          }
        }
