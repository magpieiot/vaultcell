    },
    "Your master password encrypts the entire vault and cannot be recovered. Please keep it safe." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Master-Passwort verschlüsselt den gesamten Tresor und kann nicht wiederhergestellt werden. Bitte bewahren Sie es sicher auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu contraseña maestra cifra toda la bóveda y no se puede recuperar. Guárdala en un lugar seguro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre mot de passe principal chiffre l'ensemble du coffre-fort et ne peut pas être récupéré. Veuillez le conserver en lieu sûr."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マスターパスワードはボールト全体を暗号化し、回復することはできません。安全に保管してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш мастер-пароль шифрует всё хранилище и не может быть восстановлен. Пожалуйста, храните его в безопасности."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的主密码加密整个密码库且无法恢复。请妥善保管。"
          }
        }
      }
    },
    "Your master password is required to confirm this action. This will clear Keychain and local vault data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Hauptpasswort ist erforderlich, um diese Aktion zu bestätigen. Dadurch werden Keychain und lokale Tresor-Daten gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se requiere tu contraseña maestra para confirmar esta acción. Esto borrará el Keychain y los datos locales de la bóveda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre mot de passe principal est requis pour confirmer cette action. Cela effacera le trousseau et les données locales du coffre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作を確認するにはマスターパスワードが必要です。これによりキーチェーンとローカルのボールトデータが削除されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для подтверждения этого действия требуется главный пароль. Это очистит связку ключей и локальные данные хранилища."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确认此操作需要主密码。这将清除钥匙串与本地密码库数据。"
          }
        }
      }
    },
