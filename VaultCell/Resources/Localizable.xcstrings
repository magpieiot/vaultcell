    "Clearing data cannot be undone. Export an encrypted backup before you continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelöschte Daten können nicht wiederhergestellt werden. Erstelle vorher eine verschlüsselte Sicherung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clearing data cannot be undone. Export an encrypted backup before you continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borrar los datos no se puede deshacer. Exporta antes una copia cifrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression est irréversible. Exportez d'abord une sauvegarde chiffrée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データの消去は取り消せません。先に暗号化バックアップを書き出してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление данных необратимо. Сначала экспортируйте зашифрованную резервную копию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除数据无法撤销，请先导出加密备份。"
          }
        }
      }
    },
