    "Without it, %lld accounts can’t be recovered. Rebind them before you give it up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne sie können %lld Konten nicht wiederhergestellt werden. Verknüpfen Sie diese zuerst neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin él, %lld cuentas no se pueden recuperar. Vuelve a vincularlas antes de renunciar a él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans lui, %lld comptes ne pourront pas être récupérés. Reliez-les d’abord à une autre identité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これを失うと %lld 件のアカウントが復元できなくなります。手放す前に再連携してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без него %lld аккаунтов будет невозможно восстановить. Перепривяжите их перед отказом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "失去它后有 %lld 个账户将无法找回，请先更换绑定再注销。"
          }
        }
      }
    },
