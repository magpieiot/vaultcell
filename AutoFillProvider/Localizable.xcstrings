{
  "sourceLanguage": "en",
  "strings": {
    "An item for this site and username already exists. Its password will be updated.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Website und diesen Benutzernamen ist bereits ein Eintrag vorhanden. Sein Passwort wird aktualisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An item for this site and username already exists. Its password will be updated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe un elemento para este sitio y nombre de usuario. Su contraseña se actualizará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un élément existe déjà pour ce site et ce nom d'utilisateur. Son mot de passe sera mis à jour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサイトとユーザー名のアイテムは既に存在します。パスワードが更新されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись для этого сайта и имени пользователя уже существует. Её пароль будет обновлён."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该站点与用户名已存在条目，将更新其密码。"
          }
        }
      }
    },
    "Authentication failed": {
