    "No password found for this site. Make sure the item is saved in VaultCell and has a username.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Passwort für diese Website gefunden. Stellen Sie sicher, dass der Eintrag in VaultCell gespeichert ist und einen Benutzernamen hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No password found for this site. Make sure the item is saved in VaultCell and has a username."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ninguna contraseña para este sitio. Asegúrate de que el elemento esté guardado en VaultCell y tenga un nombre de usuario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun mot de passe trouvé pour ce site. Vérifiez que l'élément est enregistré dans VaultCell et possède un identifiant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサイトのパスワードが見つかりません。VaultCell に項目が保存され、ユーザー名が入力されているか確認してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого сайта не найден пароль. Убедитесь, что элемент сохранён в VaultCell и у него указано имя пользователя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到该站点对应的密码，请先在 VaultCell 中确认该条目已保存且用户名不为空"
