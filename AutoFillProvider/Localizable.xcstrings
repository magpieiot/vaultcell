    "Couldn't read this item's password. It may have been deleted or moved in VaultCell.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort dieses Eintrags konnte nicht gelesen werden. Es wurde möglicherweise in VaultCell gelöscht oder verschoben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read this item's password. It may have been deleted or moved in VaultCell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la contraseña de este elemento. Es posible que se haya eliminado o movido en VaultCell."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le mot de passe de cet élément. Il a peut-être été supprimé ou déplacé dans VaultCell."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目のパスワードを読み取れません。VaultCell で削除または移動された可能性があります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать пароль этого элемента. Возможно, он был удалён или перемещён в VaultCell."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该条目的密码无法读取，可能已在 VaultCell 中删除或被移动"
          }
        }
      }
    },
    "Couldn't save the password. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort konnte nicht gespeichert werden. Bitte erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save the password. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la contraseña. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer le mot de passe. Veuillez réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードを保存できませんでした。もう一度お試しください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить пароль. Попробуйте снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码保存失败，请重试。"
          }
        }
      }
    },
